@page "/users"
@attribute [Authorize(Roles = "SUPER_ADMIN")]
@inject ApiService Api
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<div class="space-y-6 page-enter font-sans">
    <!-- Header Block -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-xl bg-slate-900 border border-slate-800 text-white p-6 shadow-md shadow-slate-900/10">
        <div>
            <h2 class="text-xl font-bold tracking-wide uppercase">Refinery User Directory</h2>
            <p class="text-xs text-slate-400 mt-1">
                Manage system operators, access key permissions, and department scopes.
            </p>
        </div>

        <button @onclick="OpenCreateModal" class="flex items-center gap-1.5 rounded bg-blue-600 hover:bg-blue-700 px-4 py-2.5 text-xs font-bold text-white shadow transition-all duration-200">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            <span>Create Account</span>
        </button>
    </div>

    <!-- Users Directory Table -->
    @if (loading)
    {
        <div class="flex h-64 items-center justify-center">
            <div class="h-10 w-10 animate-spin rounded-full border-4 border-iocl-orange border-t-transparent"></div>
        </div>
    }
    else if (users.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-white py-16 text-center text-slate-400">
            <svg class="h-12 w-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <p class="text-sm font-bold text-slate-500">No users found.</p>
        </div>
    }
    else
    {
        <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 font-bold uppercase tracking-wider">
                            <th class="p-4">Username</th>
                            <th class="p-4">Email</th>
                            <th class="p-4">Access Role</th>
                            <th class="p-4">Department Scope</th>
                            <th class="p-4">Account Status</th>
                            <th class="p-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                <td class="p-4 font-bold text-slate-800">@user.Username</td>
                                <td class="p-4 text-slate-600 font-medium font-mono">@user.Email</td>
                                <td class="p-4">
                                    <span class="inline-flex items-center gap-1 text-[9px] font-extrabold uppercase tracking-wider text-blue-700 bg-blue-50 border border-blue-100 rounded px-2 py-0.5">
                                        <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.952 11.952 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                                        <span>@user.Role.Replace("_", " ")</span>
                                    </span>
                                </td>
                                <td class="p-4 text-slate-600 font-bold uppercase tracking-wide">
                                    @(user.Department != null ? user.Department.Name : "ALL DEPARTMENTS")
                                </td>
                                <td class="p-4">
                                    <span class="inline-flex items-center gap-1 rounded px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-wider @(user.Status == "ACTIVE" ? "bg-emerald-50 text-emerald-700 border border-emerald-100" : "bg-red-50 text-red-700 border border-red-100")">
                                        @if (user.Status == "ACTIVE")
                                        {
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                        }
                                        else
                                        {
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                        }
                                        <span>@user.Status</span>
                                    </span>
                                </td>
                                <td class="p-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button @onclick="() => OpenEditModal(user)" class="rounded border border-slate-200 hover:bg-slate-50 p-1.5 text-slate-500 hover:text-slate-700" title="Edit User">
                                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                        </button>
                                        @if (currentUser != null && currentUser.Id != user.Id)
                                        {
                                            <button @onclick="() => DeleteUser(user.Id)" class="rounded border border-red-100 hover:bg-red-50 p-1.5 text-red-500 hover:text-red-700" title="Delete User">
                                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-4v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal Create/Edit -->
@if (isModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4" @onclick="() => isModalOpen = false">
        <div class="relative w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-2xl" @onclick:stopPropagation>
            <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">
                @(editMode ? "Edit Operator Account" : "Register Operator Account")
            </h3>

            <form @onSubmit="HandleSubmit" class="mt-4 space-y-4">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="rounded bg-red-50 border border-red-200 text-red-600 text-xs p-3 font-semibold">
                        @modalError
                    </div>
                }

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Operator Username *</label>
                        <input type="text" required disabled="@editMode" placeholder="e.g. jsmith" @bind="form.Username" class="w-full rounded-md border border-slate-200 py-2 px-3 text-xs text-slate-850 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-500 disabled:bg-slate-50 font-semibold" />
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Email Address *</label>
                        <input type="email" required placeholder="operator@iocl.co.in" @bind="form.Email" class="w-full rounded-md border border-slate-200 py-2 px-3 text-xs text-slate-850 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-500 font-semibold" />
                    </div>
                </div>

                <div>
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">
                        @(editMode ? "Update Access Key (Leave blank to keep current)" : "Access Key *")
                    </label>
                    <input type="password" required="@(!editMode)" placeholder="••••••••" @bind="form.Password" class="w-full rounded-md border border-slate-200 py-2 px-3 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Access Role *</label>
                        <select @bind="form.Role" class="w-full rounded-md border border-slate-200 bg-white py-2 px-3 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 font-semibold">
                            <option value="DEPT_ADMIN">Department Admin</option>
                            <option value="SUPER_ADMIN">Super Admin</option>
                            <option value="VIEWER">Viewer (Read-Only)</option>
                            <option value="GATEMAN">Gateman (Gate Entry Screen Only)</option>
                        </select>
                    </div>

                    @if (form.Role != "SUPER_ADMIN" && form.Role != "GATEMAN")
                    {
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Scope Division *</label>
                            <select required @bind="form.DepartmentId" class="w-full rounded-md border border-slate-200 bg-white py-2 px-3 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 font-semibold">
                                <option value="">Select Department</option>
                                @foreach (var d in departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div>
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">Scope</label>
                            <div class="w-full bg-slate-50 rounded-md border border-slate-200 py-2.5 px-3 text-[10px] text-slate-500 font-bold uppercase tracking-wider">
                                Global (Refinery-wide)
                            </div>
                        </div>
                    }
                </div>

                @if (editMode)
                {
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Account State *</label>
                        <select @bind="form.Status" class="w-full rounded-md border border-slate-200 bg-white py-2 px-3 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 font-semibold">
                            <option value="ACTIVE">ACTIVE</option>
                            <option value="INACTIVE">INACTIVE</option>
                        </select>
                    </div>
                }

                <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                    <button type="button" @onclick="() => isModalOpen = false" class="rounded border border-slate-200 hover:bg-slate-50 px-4 py-2 text-xs font-bold text-slate-500">
                        Cancel
                    </button>
                    <button type="submit" class="rounded bg-orange-500 hover:bg-orange-600 px-4 py-2 text-xs font-bold text-white shadow shadow-orange-500/20">
                        @(editMode ? "Save Account" : "Register Operator")
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    private UserDto? currentUser;
    private List<UserDto> users = new();
    private List<DepartmentDto> departments = new();
    private bool loading = true;

    // Modal States
    private bool isModalOpen = false;
    private bool editMode = false;
    private UserDto? activeUser;
    private string modalError = string.Empty;

    // We'll map the UI inputs to a locally managed DTO
    private UserForm form = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            currentUser = await Api.GetMeAsync();
            departments = await Api.GetDepartmentsAsync();
            await FetchUsers();
        }
    }

    private async Task FetchUsers()
    {
        loading = true;
        StateHasChanged();
        try
        {
            users = await Api.GetUsersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching users: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        modalError = string.Empty;
        try
        {
            if (editMode && activeUser != null)
            {
                var updateDto = new UpdateUserDto
                {
                    Email = form.Email,
                    Role = form.Role,
                    DepartmentId = (form.Role == "SUPER_ADMIN" || form.Role == "GATEMAN") ? null : form.DepartmentId,
                    Status = form.Status,
                    Password = string.IsNullOrWhiteSpace(form.Password) ? null : form.Password
                };
                await Api.UpdateUserAsync(activeUser.Id, updateDto);
            }
            else
            {
                var createDto = new CreateUserDto
                {
                    Username = form.Username,
                    Email = form.Email,
                    Password = form.Password,
                    Role = form.Role,
                    DepartmentId = (form.Role == "SUPER_ADMIN" || form.Role == "GATEMAN") ? null : form.DepartmentId
                };
                await Api.CreateUserAsync(createDto);
            }
            isModalOpen = false;
            await FetchUsers();
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
    }

    private async Task DeleteUser(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this user account?");
        if (!confirm) return;

        try
        {
            await Api.DeleteUserAsync(id);
            await FetchUsers();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private void OpenCreateModal()
    {
        form = new()
        {
            Role = "DEPT_ADMIN",
            Status = "ACTIVE"
        };
        activeUser = null;
        editMode = false;
        modalError = string.Empty;
        isModalOpen = true;
    }

    private void OpenEditModal(UserDto user)
    {
        activeUser = user;
        form = new()
        {
            Username = user.Username,
            Email = user.Email,
            Password = string.Empty,
            Role = user.Role,
            DepartmentId = user.DepartmentId,
            Status = user.Status
        };
        editMode = true;
        modalError = string.Empty;
        isModalOpen = true;
    }

    private class UserForm
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = "DEPT_ADMIN";
        public int? DepartmentId { get; set; }
        public string Status { get; set; } = "ACTIVE";
    }
}
