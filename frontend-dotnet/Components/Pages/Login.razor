@page "/"
@page "/login"
@layout LoginLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="relative flex min-h-screen items-center justify-center bg-slate-950 px-4 py-12 sm:px-6 lg:px-8 overflow-hidden">
    <!-- Background Decorative Grid -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#0f172a_1px,transparent_1px),linear-gradient(to_bottom,#0f172a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-35"></div>
    <div class="absolute top-1/4 left-1/4 -z-10 h-72 w-72 rounded-full bg-blue-900/10 blur-[120px]"></div>
    <div class="absolute bottom-1/4 right-1/4 -z-10 h-72 w-72 rounded-full bg-orange-950/10 blur-[120px]"></div>

    <!-- Main Container -->
    <div class="w-full max-w-5xl flex flex-col md:flex-row items-center justify-between gap-12 z-10">
        
        <!-- Left Side: Industrial Graphics & Stats -->
        <div class="w-full md:w-1/2 text-white space-y-6">
            <div class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl px-4 py-2.5 shadow-lg">
                <div class="bg-white rounded-xl p-1.5 shadow-sm">
                    <img src="/iocl-logo.gif" alt="IndianOil Logo" class="h-12 w-auto shrink-0" style="object-fit: contain; mix-blend-mode: multiply;" />
                </div>
                <div>
                    <p class="text-xs font-extrabold text-white uppercase tracking-widest leading-none">IndianOil</p>
                    <p class="text-[9px] text-orange-400 font-bold uppercase tracking-wider mt-0.5">Panipat Refinery</p>
                </div>
            </div>
            
            <h2 class="text-3xl font-extrabold tracking-tight text-slate-100 sm:text-4xl">
                Smart Fleet Compliance & <span class="text-orange-500">Validity Monitor</span>
            </h2>
            <p class="text-sm text-slate-400 leading-relaxed max-w-md">
                Centralized refinery ERP compliance system for vehicle verification, RTO road permits, explosives safety clearance, PUC and fitness validations.
            </p>
        </div>

        <!-- Right Side: Login Form Box -->
        <div class="w-full md:w-96 rounded-xl border border-slate-800 bg-slate-900/80 p-8 shadow-2xl backdrop-blur-md">
            <div class="text-center">
                <svg class="h-10 w-10 text-orange-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.952 11.952 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <h3 class="mt-3 text-lg font-bold text-white uppercase tracking-wider">Gate Access Portal</h3>
                <p class="text-xs text-slate-500 mt-1">Enter refinery operator credentials</p>
            </div>

            <form class="mt-6 space-y-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                @if (!string.IsNullOrEmpty(loginError))
                {
                    <div class="rounded-md bg-red-950/30 border border-red-900/40 p-3 text-xs font-medium text-red-400">
                        @loginError
                    </div>
                }

                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">Operator Username</label>
                    <div class="relative">
                        <span class="absolute left-3 top-2.5 text-slate-500">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                        </span>
                        <input type="text" required @bind="username" class="w-full rounded-lg border border-slate-800 bg-slate-950/65 py-2 pl-10 pr-4 text-sm text-slate-200 placeholder-slate-600 focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" placeholder="e.g., superadmin" />
                    </div>
                </div>

                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">Access Key</label>
                    <div class="relative">
                        <span class="absolute left-3 top-2.5 text-slate-500">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m-2 2h2m-2-2a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-4" /></svg>
                        </span>
                        <input type="password" required @bind="password" class="w-full rounded-lg border border-slate-800 bg-slate-950/65 py-2 pl-10 pr-4 text-sm text-slate-200 placeholder-slate-600 focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" placeholder="••••••••" />
                    </div>
                </div>

                <button type="submit" disabled="@loading" class="mt-2 flex w-full items-center justify-center rounded-lg bg-orange-500 hover:bg-orange-600 py-2.5 text-sm font-bold text-white shadow-lg shadow-orange-500/20 transition-all duration-200 disabled:opacity-50">
                    @(loading ? "Authenticating Gateway..." : "Verify & Enter")
                </button>
            </form>


        </div>

    </div>
</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private bool loading = false;
    private string loginError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            if (authState.User.IsInRole("GATEMAN"))
            {
                Navigation.NavigateTo("/gate-entry");
            }
            else
            {
                Navigation.NavigateTo("/dashboard");
            }
        }
    }

    private async Task HandleSubmit()
    {
        loginError = string.Empty;
        loading = true;

        try
        {
            var authProvider = (BlazorAuthStateProvider)AuthStateProvider;
            await authProvider.LoginAsync(username, password);
            var authState = await authProvider.GetAuthenticationStateAsync();
            if (authState.User.IsInRole("GATEMAN"))
            {
                Navigation.NavigateTo("/gate-entry");
            }
            else
            {
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            loginError = ex.Message ?? "Authentication failed. Please check credentials.";
        }
        finally
        {
            loading = false;
        }
    }
}
