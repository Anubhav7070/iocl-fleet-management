@page "/document-vault"
@page "/documents"
@attribute [Authorize]
@inject ApiService Api
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IConfiguration Config
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<div class="space-y-6 page-enter font-sans">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-xl bg-slate-900 border border-slate-800 text-white p-6 shadow-md shadow-slate-900/10">
        <div>
            <h2 class="text-xl font-bold tracking-wide uppercase">Document Vault</h2>
            <p class="text-xs text-slate-400 mt-1">
                View and verify all uploaded vehicle documents — RC copies & compliance certificates.
            </p>
        </div>
        <button @onclick="FetchDocs" class="flex items-center gap-1.5 rounded bg-blue-600 hover:bg-blue-700 px-4 py-2 text-xs font-bold text-white shadow transition-all duration-200">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8.89M9 11l3 3m0 0l3-3m-3 3V2" /></svg>
            <span>Refresh</span>
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="rounded-xl border border-blue-200 bg-blue-50/50 p-4 flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white border border-blue-200 text-[#0054A6]">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Total Documents</p>
                <p class="text-xl font-extrabold text-[#0054A6] mt-0.5">@docs.Count</p>
            </div>
        </div>

        <div class="rounded-xl border border-purple-200 bg-purple-50/50 p-4 flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white border border-purple-200 text-purple-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </div>
            <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">RC Copies</p>
                <p class="text-xl font-extrabold text-purple-600 mt-0.5">@rcCount</p>
            </div>
        </div>

        <div class="rounded-xl border border-orange-200 bg-orange-50/50 p-4 flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white border border-orange-200 text-orange-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
            <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Compliance Docs</p>
                <p class="text-xl font-extrabold text-orange-600 mt-0.5">@complianceCount</p>
            </div>
        </div>

        <div class="rounded-xl border border-emerald-200 bg-emerald-50/50 p-4 flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white border border-emerald-200 text-emerald-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.952 11.952 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Verified Docs</p>
                <p class="text-xl font-extrabold text-emerald-600 mt-0.5">@verifiedCount</p>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="flex flex-col sm:flex-row gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </span>
            <input type="text" @bind="search" @bind:event="oninput" placeholder="Search by vehicle number, department, file name..." class="w-full rounded border border-slate-200 bg-slate-50 pl-9 pr-4 py-2 text-xs font-semibold text-slate-600 outline-none focus:border-blue-500 focus:bg-white transition-all" />
        </div>
        <select @bind="filterType" class="rounded border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 outline-none focus:border-blue-500 transition-all font-sans">
            <option value="">All Document Types</option>
            <option value="VEHICLE_RC">RC Copies Only</option>
            <option value="COMPLIANCE">Compliance Certs Only</option>
        </select>
        <select @bind="filterVerified" class="rounded border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 outline-none focus:border-blue-500 transition-all font-sans">
            <option value="">All Verification Status</option>
            <option value="true">Verified Only</option>
            <option value="false">Pending Only</option>
        </select>
    </div>

    <!-- Document Table -->
    @if (loading)
    {
        <div class="flex h-48 items-center justify-center">
            <div class="h-8 w-8 animate-spin rounded-full border-4 border-iocl-orange border-t-transparent"></div>
        </div>
    }
    else
    {
        var filteredList = GetFilteredDocs();
        @if (filteredList.Count == 0)
        {
            <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-white py-16 text-slate-400">
                <svg class="h-12 w-12 mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                <p class="text-sm font-bold text-slate-500">No documents found matching filters.</p>
                <p class="text-xs text-slate-400 mt-1 font-semibold">Upload RC copies or compliance certificates to populate the registry.</p>
            </div>
        }
        else
        {
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="flex items-center justify-between px-5 py-3 bg-slate-50 border-b border-slate-200">
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-widest">
                        Showing @filteredList.Count of @docs.Count documents
                    </p>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 font-bold uppercase tracking-wider">
                                <th class="p-4 w-12">#</th>
                                <th class="p-4">File</th>
                                <th class="p-4">Vehicle No</th>
                                <th class="p-4">Department</th>
                                <th class="p-4">Document Type</th>
                                <th class="p-4">Uploaded On</th>
                                <th class="p-4">Verified</th>
                                <th class="p-4 text-right">Verify</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var idx = 0; idx < filteredList.Count; idx++)
                            {
                                var doc = filteredList[idx];
                                var index = idx;
                                var isRC = doc.Type == "VEHICLE_RC";
                                
                                <tr class="border-b border-slate-100 hover:bg-slate-50/60 transition-colors">
                                    <td class="p-4 font-mono text-slate-400">@(index + 1)</td>
                                    <td class="p-4">
                                        <div class="flex items-center gap-3">
                                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border @(isRC ? "bg-purple-50 border-purple-200 text-purple-600" : "bg-orange-50 border-orange-200 text-orange-600")">
                                                @if (doc.FileName.ToLower().EndsWith(".pdf"))
                                                {
                                                    <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                                                }
                                                else
                                                {
                                                    <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                                }
                                            </div>
                                            <div class="min-w-0">
                                                <p class="text-xs font-bold text-slate-700 truncate max-w-[140px]" title="@doc.FileName">@doc.FileName</p>
                                                <span class="inline-block mt-0.5 rounded px-1.5 py-0.5 text-[8px] font-extrabold uppercase tracking-wide @(isRC ? "bg-purple-100 text-purple-700" : "bg-orange-100 text-orange-700")">
                                                    @(isRC ? "RC" : "CERT")
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="p-4">
                                        <span class="text-xs font-bold text-slate-700 font-mono tracking-wider">@doc.VehicleNumber</span>
                                    </td>
                                    <td class="p-4">
                                        <span class="text-xs text-slate-600 font-semibold">@doc.DepartmentName</span>
                                    </td>
                                    <td class="p-4">
                                        <span class="text-xs font-bold text-slate-700">@doc.DocumentType.Replace("_", " ")</span>
                                    </td>
                                    <td class="p-4 font-mono text-slate-500 font-semibold whitespace-nowrap">
                                        @FormatDate(doc.UploadedAt)
                                    </td>
                                    <td class="p-4">
                                        @if (doc.IsVerified)
                                        {
                                            <div class="flex items-center gap-1.5">
                                                <svg class="h-4.5 w-4.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.952 11.952 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                                                <div>
                                                    <p class="text-[9px] font-extrabold text-emerald-700 uppercase leading-none">Verified</p>
                                                    @if (!string.IsNullOrEmpty(doc.VerifiedBy))
                                                    {
                                                        <p class="text-[8px] text-slate-400 font-mono mt-0.5">by @doc.VerifiedBy</p>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flex items-center gap-1.5">
                                                <svg class="h-4.5 w-4.5 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                <p class="text-[9px] font-extrabold text-amber-600 uppercase">Pending</p>
                                            </div>
                                        }
                                    </td>
                                    <td class="p-4 text-right">
                                        @if (currentUser?.Role == "SUPER_ADMIN")
                                        {
                                            @if (doc.IsVerified)
                                            {
                                                <button @onclick="() => ToggleVerify(doc)" class="rounded bg-red-50 text-red-600 hover:bg-red-100 px-3 py-1.5 text-[10px] font-bold transition-colors whitespace-nowrap border border-red-200">
                                                    Revoke
                                                </button>
                                            }
                                            else
                                            {
                                                <button @onclick="() => ToggleVerify(doc)" class="rounded bg-emerald-50 text-emerald-700 hover:bg-emerald-100 px-3 py-1.5 text-[10px] font-bold transition-colors whitespace-nowrap border border-emerald-200">
                                                    Verify
                                                </button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer details -->
                <div class="flex items-center justify-between px-5 py-3 bg-slate-50 border-t border-slate-200 font-mono text-[9px] text-slate-400">
                    <div>
                        @verifiedCount verified · @pendingCount pending · @docs.Count total
                    </div>
                    <div>
                        Super Admin Registry access
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private UserDto? currentUser;
    private List<UploadedDocumentDto> docs = new();
    private bool loading = true;
    private string search = string.Empty;
    private string filterType = string.Empty;
    private string filterVerified = string.Empty;
    
    private string apiBaseUrl = string.Empty;

    // Counts
    private int rcCount;
    private int complianceCount;
    private int verifiedCount;
    private int pendingCount;

    protected override async Task OnInitializedAsync()
    {
        apiBaseUrl = Config["Backend:Url"] ?? "http://localhost:5000";
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            currentUser = await Api.GetMeAsync();
            await FetchDocs();
        }
    }

    private async Task FetchDocs()
    {
        loading = true;
        StateHasChanged();
        try
        {
            docs = await Api.GetUploadedDocumentsAsync();
            
            // Calculations
            rcCount = docs.Count(d => d.Type == "VEHICLE_RC");
            complianceCount = docs.Count(d => d.Type == "COMPLIANCE");
            verifiedCount = docs.Count(d => d.IsVerified);
            pendingCount = docs.Count(d => !d.IsVerified);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching documents: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private List<UploadedDocumentDto> GetFilteredDocs()
    {
        var query = docs.AsQueryable();

        if (!string.IsNullOrEmpty(search))
        {
            query = query.Where(d => 
                d.VehicleNumber.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                d.DepartmentName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                d.FileName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                d.DocumentType.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(filterType))
        {
            query = query.Where(d => d.Type == filterType);
        }

        if (!string.IsNullOrEmpty(filterVerified))
        {
            bool targetVal = bool.Parse(filterVerified);
            query = query.Where(d => d.IsVerified == targetVal);
        }

        return query.ToList();
    }

    private string FormatDate(DateTime d)
    {
        return d.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt");
    }

    private async Task DownloadFile(string filePath, string fileName)
    {
        try
        {
            var url = $"{apiBaseUrl}{filePath}";
            // Retrieve the session token so the JS helper can pass it if the
            // endpoint ever requires auth; for static /uploads it is optional.
            string token = string.Empty;
            try
            {
                var result = await SessionStorage.GetAsync<string>("iocl_session_token");
                if (result.Success && result.Value != null)
                    token = result.Value;
            }
            catch { /* ignore – token is optional for static files */ }

            await JS.InvokeVoidAsync("ioclHelpers.downloadFile", url, fileName, token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DocumentVault] Download error: {ex.Message}");
        }
    }

    private async Task ToggleVerify(UploadedDocumentDto doc)
    {
        try
        {
            var targetStatus = !doc.IsVerified;
            if (doc.Type == "VEHICLE_RC")
            {
                await Api.VerifyVehicleAsync(doc.RecordId, targetStatus);
            }
            else
            {
                await Api.VerifyComplianceDocumentAsync(doc.RecordId, targetStatus);
            }

            await FetchDocs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling verify status: {ex.Message}");
        }
    }
}
