@page "/renewals-history"
@attribute [Authorize]
@inject ApiService Api
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IConfiguration Config

<div class="space-y-6 page-enter font-sans">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-xl bg-slate-900 border border-slate-800 text-white p-6 shadow-md shadow-slate-900/10">
        <div>
            <h2 class="text-xl font-bold tracking-wide uppercase">Refinery Renewal Audit Log</h2>
            <p class="text-xs text-slate-400 mt-1">
                Archived log of vehicle compliance certificates and active renewals.
            </p>
        </div>
        <button @onclick="FetchHistory" class="flex items-center gap-1.5 rounded bg-blue-600 hover:bg-blue-700 px-4 py-2 text-xs font-bold text-white shadow transition-all duration-200">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8.89M9 11l3 3m0 0l3-3m-3 3V2" /></svg>
            <span>Refresh</span>
        </button>
    </div>

    <!-- History Table -->
    @if (loading)
    {
        <div class="flex h-48 items-center justify-center">
            <div class="h-8 w-8 animate-spin rounded-full border-4 border-iocl-orange border-t-transparent"></div>
        </div>
    }
    else if (history.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-white py-16 text-center text-slate-400">
            <svg class="h-12 w-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            <p class="text-sm font-bold text-slate-500">No renewal history records archived in the system yet.</p>
        </div>
    }
    else
    {
        <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 font-bold uppercase tracking-wider">
                            <th class="p-4">Vehicle Number</th>
                            <th class="p-4">Compliance Type</th>
                            <th class="p-4">Expiry Transition</th>
                            <th class="p-4">Authorized Operator</th>
                            <th class="p-4">Archived Certificate</th>
                            <th class="p-4">Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in history)
                        {
                            <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                <td class="p-4 font-bold text-slate-800 font-mono tracking-wider">
                                    @(log.Vehicle != null ? log.Vehicle.VehicleNumber : "DECOMMISSIONED")
                                </td>
                                <td class="p-4 font-semibold text-slate-600">
                                    @log.LicenseType.Replace("_", " ")
                                </td>
                                <td class="p-4 font-mono font-bold text-slate-600">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-red-600">@FormatDate(log.OldExpiryDate)</span>
                                        <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                                        <span class="text-emerald-600">@FormatDate(log.NewExpiryDate)</span>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center gap-1 text-slate-600 font-bold">
                                        <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                        <span>@(!string.IsNullOrEmpty(log.RenewedBy) ? log.RenewedBy : "System")</span>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center gap-4">
                                        @if (log.OldDocument != null)
                                        {
                                            <a href="@($"{apiBaseUrl}{log.OldDocument.FilePath}")" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[10px] font-bold text-slate-400 hover:text-slate-600 uppercase tracking-widest" title="View Old Certificate">
                                                <span>Prev</span>
                                                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                            </a>
                                        }
                                        @if (log.NewDocument != null)
                                        {
                                            <a href="@($"{apiBaseUrl}{log.NewDocument.FilePath}")" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[10px] font-bold text-blue-600 hover:text-blue-700 uppercase tracking-widest" title="View New Certificate">
                                                <span>Current</span>
                                                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] font-semibold text-slate-400">No Attachment</span>
                                        }
                                    </div>
                                </td>
                                <td class="p-4 font-mono text-slate-500 font-medium">
                                    @FormatDateTime(log.RenewedAt)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<RenewalHistoryDto> history = new();
    private bool loading = true;
    private string apiBaseUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        apiBaseUrl = Config["Backend:Url"] ?? "http://localhost:5000";
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await FetchHistory();
        }
    }

    private async Task FetchHistory()
    {
        loading = true;
        StateHasChanged();
        try
        {
            history = await Api.GetRenewalHistoryAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching renewals history: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private string FormatDate(string? d)
    {
        if (string.IsNullOrEmpty(d) || d == "PENDING") return "PENDING";
        if (DateTime.TryParse(d, out var dt))
        {
            return dt.ToString("dd-MMM-yyyy");
        }
        return d;
    }

    private string FormatDateTime(DateTime d)
    {
        return d.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt");
    }
}
