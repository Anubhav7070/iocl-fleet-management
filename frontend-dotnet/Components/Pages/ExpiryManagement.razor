@page "/expiry-management"
@attribute [Authorize]
@inject ApiService Api
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IConfiguration Config

<div class="space-y-6 page-enter">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 rounded-xl bg-slate-900 border border-slate-800 text-white p-6 shadow-md shadow-slate-900/10">
        <div>
            <h2 class="text-xl font-bold tracking-wide uppercase">Refinery Expiry Management</h2>
            <p class="text-xs text-slate-400 mt-1">
                Review and renew expired compliance permits and security gate logs.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button @onclick='() => DownloadExpiryReport("pdf")' disabled="@(downloading == "pdf")" class="flex items-center gap-1.5 rounded bg-blue-600 hover:bg-blue-700 disabled:opacity-60 disabled:cursor-wait px-3.5 py-2.5 text-xs font-bold text-white shadow transition-all duration-200">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                <span>@(downloading == "pdf" ? "Exporting PDF..." : "Export Expiries PDF")</span>
            </button>
            <button @onclick='() => DownloadExpiryReport("excel")' disabled="@(downloading == "excel")" class="flex items-center gap-1.5 rounded border border-slate-700 bg-slate-850 hover:bg-slate-800 disabled:opacity-60 disabled:cursor-wait px-3.5 py-2.5 text-xs font-bold text-slate-300 shadow transition-all duration-200">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                <span>@(downloading == "excel" ? "Exporting Excel..." : "Download Excel Sheet")</span>
            </button>
        </div>
    </div>

    <!-- Expiry KPI stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-xl border border-slate-200 bg-white p-5 card-hover flex items-center justify-between">
            <div>
                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest block">Total Flagged</span>
                <p class="mt-1 text-2xl font-extrabold text-slate-800">@alerts.Count</p>
            </div>
            <span class="rounded bg-slate-50 p-2.5 text-slate-500">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </span>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-5 card-hover flex items-center justify-between">
            <div>
                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest block">Expired Documents</span>
                <p class="mt-1 text-2xl font-extrabold text-red-600">@expiredCount</p>
            </div>
            <span class="rounded bg-red-50 p-2.5 text-red-500 animate-pulse">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </span>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-5 card-hover flex items-center justify-between">
            <div>
                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest block">High/Critical Expiries</span>
                <p class="mt-1 text-2xl font-extrabold text-orange-600">@criticalCount</p>
            </div>
            <span class="rounded bg-orange-50 p-2.5 text-orange-500">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </span>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-5 card-hover flex items-center justify-between">
            <div>
                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest block">Warnings & Expiring</span>
                <p class="mt-1 text-2xl font-extrabold text-yellow-600">@warningCount</p>
            </div>
            <span class="rounded bg-yellow-50 p-2.5 text-yellow-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </span>
        </div>
    </div>

    <!-- Filters Control Panel -->
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm flex flex-col lg:flex-row gap-4">
        <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </span>
            <input type="text" @bind="search" @bind:event="oninput" placeholder="Search by Vehicle Number..." class="w-full rounded border border-slate-200 bg-slate-50 pl-9 pr-4 py-2 text-xs font-semibold text-slate-600 outline-none focus:border-blue-500 focus:bg-white transition-all" />
        </div>

        <div class="flex flex-wrap items-center gap-3">
            @if (currentUser?.Role == "SUPER_ADMIN")
            {
                <select @bind="filterDept" @bind:after="FetchAlerts" class="rounded border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 outline-none focus:border-blue-500 transition-all">
                    <option value="">All Departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            }

            <select @bind="filterPriority" @bind:after="FetchAlerts" class="rounded border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 outline-none focus:border-blue-500 transition-all">
                <option value="">All Priority Levels</option>
                <option value="HIGH">High / Critical & Expired</option>
                <option value="MEDIUM">Medium Priority</option>
                <option value="LOW">Low / Warning</option>
            </select>
        </div>
    </div>

    <!-- Expiries List Table -->
    @if (loading)
    {
        <div class="flex h-64 items-center justify-center">
            <div class="h-8 w-8 animate-spin rounded-full border-4 border-iocl-orange border-t-transparent"></div>
        </div>
    }
    else
    {
        var filteredList = GetFilteredAlerts();
        @if (filteredList.Count == 0)
        {
            <div class="rounded-xl border border-dashed border-slate-300 bg-white py-16 text-center text-slate-400">
                <svg class="h-10 w-10 text-emerald-500 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <p class="text-sm font-semibold text-slate-500">No active warnings or expired compliance entries found.</p>
            </div>
        }
        else
        {
            <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 font-bold uppercase tracking-wider">
                                <th class="p-4">Vehicle Number</th>
                                <th class="p-4">Department</th>
                                <th class="p-4">Document Type</th>
                                <th class="p-4">License Number</th>
                                <th class="p-4">Expiry Date</th>
                                <th class="p-4">Remaining / Overdue</th>
                                <th class="p-4">Priority Status</th>
                                <th class="p-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in filteredList)
                            {
                                <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                    <td class="p-4 font-mono font-bold text-slate-800 tracking-wider">
                                        @(record.Vehicle != null ? record.Vehicle.VehicleNumber : "N/A")
                                    </td>
                                    <td class="p-4 font-semibold text-slate-500">
                                        @(record.Vehicle?.Department != null ? record.Vehicle.Department.Name : "N/A")
                                    </td>
                                    <td class="p-4 font-bold text-slate-700">
                                        @record.LicenseType.Replace("_", " ")
                                    </td>
                                    <td class="p-4 font-mono font-semibold text-slate-600">
                                        @(!string.IsNullOrEmpty(record.LicenseNumber) ? record.LicenseNumber : "PENDING")
                                    </td>
                                    <td class="p-4 font-mono font-semibold text-slate-600">
                                        @FormatDate(record.ExpiryDate)
                                    </td>
                                    <td class="p-4">
                                        <span class="font-bold @GetRemainingDaysColor(record.Status)">
                                            @GetRemainingDaysLabel(record.ExpiryDate)
                                        </span>
                                    </td>
                                    <td class="p-4">
                                        <span class="inline-block rounded border px-2 py-0.5 text-[8.5px] font-extrabold uppercase tracking-widest @GetPriorityStyle(record.Status)">
                                            @GetPriorityLabel(record.Status)
                                        </span>
                                    </td>
                                    <td class="p-4 text-right">
                                        <div class="flex items-center justify-end gap-3">
                                            @if (record.DocumentId.HasValue && record.Document != null)
                                            {
                                                <a href="@($"{apiBaseUrl}{record.Document.FilePath}")" target="_blank" rel="noopener noreferrer" class="flex items-center gap-0.5 text-blue-600 hover:text-blue-700 font-bold uppercase tracking-widest text-[9.5px]">
                                                    <span>Doc</span>
                                                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-[8px] font-bold text-slate-400 uppercase tracking-widest">No Doc</span>
                                            }

                                            @if (currentUser?.Role != "VIEWER")
                                            {
                                                <button @onclick="() => HandleRenewClick(record)" class="rounded border border-orange-500 bg-white hover:bg-orange-50 px-2.5 py-1.5 text-[8.5px] font-extrabold text-orange-600 uppercase tracking-widest transition-all">
                                                    Renew
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<!-- Modal: Renew Compliance Record -->
@if (isRenewOpen && activeRecord != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4" @onclick="() => isRenewOpen = false">
        <div class="relative w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-2xl" @onclick:stopPropagation>
            <div class="flex items-start gap-3 border-b border-slate-100 pb-3">
                <span class="rounded-full bg-orange-50 p-2 text-orange-500 shrink-0">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                </span>
                <div>
                    <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Renew Certificate</h3>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">
                        Category: @activeRecord.LicenseType.Replace("_", " ") (@(activeRecord.Vehicle?.VehicleNumber))
                    </p>
                </div>
            </div>

            <form @onSubmit="HandleRenewSubmit" class="mt-4 space-y-4">
                @if (!string.IsNullOrEmpty(renewalError))
                {
                    <div class="rounded bg-red-50 border border-red-200 text-red-600 text-xs p-3 font-semibold">
                        @renewalError
                    </div>
                }

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">License Number *</label>
                        <input type="text" required placeholder="e.g. LN-9876-X" @bind="renewalForm.LicenseNumber" class="w-full rounded-md border border-slate-200 py-2 px-3 text-xs text-slate-700 outline-none focus:border-blue-500 font-mono uppercase" />
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Issuing Authority *</label>
                        <input type="text" required placeholder="e.g. RTO Panipat" @bind="renewalForm.IssuingAuthority" class="w-full rounded-md border border-slate-200 py-2 px-3 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Issue Date</label>
                        <input type="date" @bind="issueDateBind" class="w-full rounded-md border border-slate-200 py-2 px-3 text-xs text-slate-700 focus:border-blue-500 outline-none" />
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Expiry Date *</label>
                        <input type="date" readonly="readonly" required @bind="expiryDateBind" class="w-full rounded-md border border-slate-250 bg-slate-100 py-2 px-3 text-xs text-slate-500 outline-none cursor-not-allowed" title="Expiry Date (Auto-extracted from PDF)" />
                    </div>
                </div>

                <!-- File Attachment Upload -->
                <div>
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">
                        Upload Scanned Certificate (PDF/Image) *
                    </label>
                    <div class="relative flex items-center justify-center border border-dashed border-slate-300 rounded-md bg-slate-50/50 p-4 hover:bg-slate-100 transition-colors duration-200 cursor-pointer">
                        <InputFile OnChange="HandleFileSelected" required accept=".pdf,.png,.jpg,.jpeg" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                        <div class="text-center text-[10px] font-semibold text-slate-500">
                            @if (extractingDate)
                            {
                                <div class="flex items-center justify-center gap-2">
                                    <div class="h-4 w-4 animate-spin rounded-full border-2 border-orange-500 border-t-transparent"></div>
                                    <span class="text-orange-600 font-bold">Scanning PDF...</span>
                                </div>
                            }
                            else if (uploadFile != null)
                            {
                                <svg class="h-5 w-5 text-emerald-500 mx-auto mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.952 11.952 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                                <span class="text-blue-600 font-bold">@uploadFile.Name</span>
                            }
                            else
                            {
                                <svg class="h-6 w-6 text-slate-400 mx-auto mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                                <span>Drag & drop or <span class="text-blue-600 underline">browse</span> (PDF/Image, Max 10MB)</span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(dateExtractMsg))
                    {
                        <div class="mt-2 rounded px-3 py-2 text-[10px] font-semibold @(dateExtractFound ? "bg-emerald-50 border border-emerald-200 text-emerald-700" : "bg-amber-50 border border-amber-200 text-amber-700")">
                            @dateExtractMsg
                        </div>
                    }
                </div>

                <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                    <button type="button" @onclick="() => isRenewOpen = false" class="rounded border border-slate-200 hover:bg-slate-50 px-4 py-2 text-xs font-bold text-slate-500">
                        Cancel
                    </button>
                    <button type="submit" class="rounded bg-orange-500 hover:bg-orange-600 px-4 py-2 text-xs font-bold text-white shadow shadow-orange-500/20">
                        Process Renewal
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "renewId")]
    public int? RenewId { get; set; }

    private UserDto? currentUser;
    private List<ComplianceRecordDto> alerts = new();
    private List<DepartmentDto> departments = new();
    private bool loading = true;
    private string search = string.Empty;
    private string filterDept = string.Empty;
    private string filterPriority = string.Empty;

    private string downloading = string.Empty;
    private string apiBaseUrl = string.Empty;

    // Renew Modal States
    private bool isRenewOpen = false;
    private ComplianceRecordDto? activeRecord;
    private RenewComplianceDto renewalForm = new();
    private DateTime? issueDateBind;
    private DateTime? expiryDateBind;
    private IBrowserFile? uploadFile;
    private string renewalError = string.Empty;
    private bool extractingDate = false;
    private string dateExtractMsg = string.Empty;
    private bool dateExtractFound = false;

    // KPI Counts
    private int expiredCount;
    private int criticalCount;
    private int warningCount;

    protected override async Task OnInitializedAsync()
    {
        apiBaseUrl = Config["Backend:Url"] ?? "http://localhost:5000";
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            currentUser = await Api.GetMeAsync();
            departments = await Api.GetDepartmentsAsync();
            await FetchAlerts();

            // Automatically open renewal if query parameter was supplied
            if (RenewId.HasValue)
            {
                var record = alerts.FirstOrDefault(x => x.Id == RenewId.Value);
                if (record != null)
                {
                    HandleRenewClick(record);
                }
            }
        }
    }

    private async Task FetchAlerts()
    {
        loading = true;
        StateHasChanged();
        try
        {
            int? deptId = string.IsNullOrEmpty(filterDept) ? null : int.Parse(filterDept);
            alerts = await Api.GetComplianceAlertsAsync(deptId, filterPriority);

            // Compute KPI metrics
            expiredCount = alerts.Count(a => a.Status == "EXPIRED");
            criticalCount = alerts.Count(a => a.Status == "HIGH_CRITICAL" || a.Status == "MEDIUM_CRITICAL" || a.Status == "CRITICAL");
            warningCount = alerts.Count(a => a.Status == "WARNING");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching alerts: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private List<ComplianceRecordDto> GetFilteredAlerts()
    {
        if (string.IsNullOrEmpty(search)) return alerts;
        return alerts
            .Where(a => a.Vehicle != null && a.Vehicle.VehicleNumber.Contains(search, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void HandleRenewClick(ComplianceRecordDto record)
    {
        activeRecord = record;
        renewalForm = new()
        {
            LicenseNumber = record.LicenseNumber != "PENDING" ? record.LicenseNumber : "",
            IssuingAuthority = record.IssuingAuthority != "PENDING" ? record.IssuingAuthority : "",
            IssueDate = record.IssueDate,
            ExpiryDate = record.ExpiryDate
        };
        
        issueDateBind = DateTime.TryParse(record.IssueDate, out var idt) ? idt : null;
        expiryDateBind = DateTime.TryParse(record.ExpiryDate, out var edt) ? edt : null;

        uploadFile = null;
        renewalError = string.Empty;
        isRenewOpen = true;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        uploadFile = e.File;
        renewalError = string.Empty;
        dateExtractMsg = string.Empty;
        dateExtractFound = false;

        if (uploadFile == null) return;

        // Only allow PDF files for compliance verification
        if (!uploadFile.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            dateExtractMsg = "❌ Only PDF files are allowed. Scanned images are not permitted for security verification.";
            dateExtractFound = false;
            uploadFile = null; // Reset the selected file
            StateHasChanged();
            return;
        }

        extractingDate = true;
        dateExtractMsg = "🔍 Scanning document for expiry date...";
        StateHasChanged();

        try
        {
            using var stream = uploadFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var (found, date, message) = await Api.ExtractDateFromDocumentAsync(stream, uploadFile.Name, uploadFile.ContentType);
            dateExtractFound = found;
            
            if (found && date != null && DateTime.TryParse(date, out var detectedDate))
            {
                dateExtractMsg = $"✅ {message}";
                expiryDateBind = detectedDate;
            }
            else
            {
                dateExtractMsg = $"❌ Could not extract a valid expiry date. To prevent compliance fraud, a readable PDF containing a valid expiry date is required.";
                dateExtractFound = false;
                uploadFile = null; // Reject file
            }
        }
        catch (Exception ex)
        {
            dateExtractMsg = $"❌ Could not scan document: {ex.Message}";
            dateExtractFound = false;
            uploadFile = null; // Reject file
        }
        finally
        {
            extractingDate = false;
            StateHasChanged();
        }
    }

    private async Task HandleRenewSubmit()
    {
        if (!expiryDateBind.HasValue)
        {
            renewalError = "Expiry date is required.";
            return;
        }
        if (uploadFile == null)
        {
            renewalError = "Scanned certificate document is mandatory.";
            return;
        }

        renewalForm.IssueDate = issueDateBind?.ToString("yyyy-MM-dd");
        renewalForm.ExpiryDate = expiryDateBind.Value.ToString("yyyy-MM-dd");

        renewalError = string.Empty;
        try
        {
            using var stream = uploadFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // Max 5MB
            await Api.RenewComplianceRecordAsync(activeRecord!.Id, renewalForm, stream, uploadFile.Name, uploadFile.ContentType);
            
            isRenewOpen = false;
            activeRecord = null;
            await FetchAlerts();
        }
        catch (Exception ex)
        {
            renewalError = ex.Message;
        }
    }

    private async Task DownloadExpiryReport(string format)
    {
        if (downloading == format) return;
        downloading = format;
        StateHasChanged();

        try
        {
            var response = await Api.DownloadExpiryReportAsync(format);
            var bytes = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);
            var filename = $"IOCL_Expiry_Report.{(format == "excel" ? "xlsx" : "pdf")}";
            var mime = format == "excel" ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" : "application/pdf";
            
            await JS.InvokeVoidAsync("window.downloadFile", base64, filename, mime);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Report download failed: {ex.Message}");
        }
        finally
        {
            downloading = string.Empty;
            StateHasChanged();
        }
    }

    private string FormatDate(string? d)
    {
        if (string.IsNullOrEmpty(d) || d == "PENDING") return "PENDING";
        if (DateTime.TryParse(d, out var dt))
        {
            return dt.ToString("dd-MMM-yyyy");
        }
        return d;
    }

    private int? DaysLeft(string? expiry)
    {
        if (string.IsNullOrEmpty(expiry) || expiry == "PENDING") return null;
        if (DateTime.TryParse(expiry, out var exp))
        {
            return (int)Math.Ceiling((exp.Date - DateTime.Today).TotalDays);
        }
        return null;
    }

    private string GetRemainingDaysLabel(string? expiry)
    {
        var days = DaysLeft(expiry);
        if (!days.HasValue) return "N/A";
        if (days.Value < 0) return $"{Math.Abs(days.Value)} days overdue";
        if (days.Value == 0) return "Expires today";
        return $"{days.Value} days remaining";
    }

    private string GetRemainingDaysColor(string status)
    {
        return status switch
        {
            "EXPIRED" => "text-red-600 font-bold",
            "HIGH_CRITICAL" or "MEDIUM_CRITICAL" or "CRITICAL" => "text-orange-600",
            _ => "text-amber-600"
        };
    }

    private string GetPriorityStyle(string status)
    {
        return status switch
        {
            "EXPIRED" => "bg-red-50 text-red-700 border-red-200",
            "HIGH_CRITICAL" or "MEDIUM_CRITICAL" or "CRITICAL" => "bg-orange-50 text-orange-700 border-orange-200",
            "WARNING" => "bg-amber-50 text-amber-700 border-amber-200",
            _ => "bg-slate-50 text-slate-700 border-slate-200"
        };
    }

    private string GetPriorityLabel(string status)
    {
        return status switch
        {
            "EXPIRED" => "IMMEDIATE RED",
            "HIGH_CRITICAL" or "CRITICAL" => "HIGH PRIORITY",
            "MEDIUM_CRITICAL" => "MEDIUM PRIORITY",
            "WARNING" => "LOW / WARNING",
            _ => status
        };
    }
}
