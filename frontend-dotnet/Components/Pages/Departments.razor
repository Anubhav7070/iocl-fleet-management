@page "/departments"
@attribute [Authorize]
@inject ApiService Api
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IConfiguration Config

<div class="space-y-6 page-enter">
    <!-- QR Scanner overlay (Specific to a Department Gate) -->
    @if (scannerDept != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4" @onclick="CloseScanner">
            <div class="relative w-full max-w-sm rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl overflow-hidden p-6" @onclick:stopPropagation>
                
                <!-- Scanner Header -->
                <div class="flex items-center justify-between border-b border-slate-800 pb-3.5 mb-4">
                    <div class="flex items-center gap-2.5">
                        <svg class="h-5 w-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h.01M16 16h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <div>
                            <p class="text-[10px] font-extrabold text-slate-300 uppercase tracking-widest">QR Gate Scanner</p>
                            <p class="text-[8.5px] text-orange-400 font-bold uppercase tracking-wide">@scannerDept.Name</p>
                        </div>
                    </div>
                    <button @onclick="CloseScanner" class="rounded-full p-1.5 hover:bg-slate-800 text-slate-400 hover:text-white transition-colors">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(cameraError))
                {
                    <div class="rounded-xl bg-red-950/40 border border-red-900/50 text-red-400 text-xs p-4 mb-4 text-center leading-relaxed">
                        @cameraError
                    </div>
                }

                @if (isScanning)
                {
                    <!-- Live Camera Feed -->
                    <div class="relative rounded-xl overflow-hidden bg-black border border-slate-800 aspect-video flex items-center justify-center">
                        <video id="dept-scan-video" class="absolute w-full h-full object-cover"></video>
                        <canvas id="dept-scan-canvas" class="hidden"></canvas>

                        <div class="absolute inset-0 border-[24px] border-black/50 flex items-center justify-center pointer-events-none">
                            <div class="w-32 h-32 border border-dashed border-orange-500 animate-pulse relative">
                                <div class="absolute -top-1 -left-1 w-4.5 h-4.5 border-t-4 border-l-4 border-orange-500"></div>
                                <div class="absolute -top-1 -right-1 w-4.5 h-4.5 border-t-4 border-r-4 border-orange-500"></div>
                                <div class="absolute -bottom-1 -left-1 w-4.5 h-4.5 border-b-4 border-l-4 border-orange-500"></div>
                                <div class="absolute -bottom-1 -right-1 w-4.5 h-4.5 border-b-4 border-r-4 border-orange-500"></div>
                            </div>
                        </div>

                        <span class="absolute bottom-2 rounded bg-slate-950/80 px-2 py-1 text-[8px] text-white font-bold tracking-wider uppercase">
                            Align QR Code In Frame
                        </span>
                    </div>
                }

                @if (loadingResult)
                {
                    <div class="flex flex-col items-center gap-3 py-10">
                        <div class="h-8 w-8 animate-spin rounded-full border-4 border-orange-500 border-t-transparent"></div>
                        <p class="text-[9px] text-slate-400 uppercase font-bold tracking-widest">Querying gate records...</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(scanError) && !loadingResult)
                {
                    <div class="rounded-xl border border-red-900/50 bg-red-950/20 p-5 text-center space-y-3">
                        <svg class="h-8 w-8 text-red-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <p class="text-[10px] font-bold text-red-400 uppercase tracking-wider">Verification Failed</p>
                        <p class="text-[9.5px] text-red-500 leading-normal">@scanError</p>
                        <button @onclick="ResetScanner" class="mt-2 rounded-lg bg-slate-800 hover:bg-slate-700 px-4 py-1.5 text-[9.5px] font-bold text-white uppercase tracking-wider transition-colors">
                            Scan Again
                        </button>
                    </div>
                }

                @if (scanResult != null && !loadingResult)
                {
                    var isCleared = scanResult.Status == "FULLY_COMPLIANT";
                    <div class="space-y-4">
                        <!-- Clearance Indicator -->
                        @if (isCleared)
                        {
                            <div class="rounded-xl border border-emerald-900/40 bg-emerald-950/30 p-4 text-center">
                                <svg class="h-10 w-10 text-emerald-400 mx-auto mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.952 11.952 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                                <p class="text-xs font-extrabold text-emerald-300 uppercase tracking-widest">Clearance Granted</p>
                                <p class="text-[9.5px] text-emerald-600 font-semibold mt-1">Vehicle OK to enter @scannerDept.Code Division</p>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-xl border border-red-950/40 bg-red-950/30 p-4 text-center">
                                <svg class="h-10 w-10 text-red-500 mx-auto mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                                <p class="text-xs font-extrabold text-red-400 uppercase tracking-widest">Entry Denied</p>
                                <p class="text-[9.5px] text-red-500 font-semibold mt-1">Expired or missing compliance certificates</p>
                            </div>
                        }

                        <!-- Details card -->
                        <div class="rounded-lg bg-slate-850 border border-slate-800 divide-y divide-slate-800 text-[10px]">
                            <div class="flex justify-between px-3 py-2">
                                <span class="text-slate-500 font-bold uppercase tracking-wider">Reg. No</span>
                                <span class="font-bold text-slate-200 font-mono">@scanResult.VehicleNumber</span>
                            </div>
                            <div class="flex justify-between px-3 py-2">
                                <span class="text-slate-500 font-bold uppercase tracking-wider">Type</span>
                                <span class="font-bold text-slate-200">@scanResult.VehicleType</span>
                            </div>
                            <div class="flex justify-between px-3 py-2">
                                <span class="text-slate-500 font-bold uppercase tracking-wider">Driver</span>
                                <span class="font-bold text-slate-200">@(string.IsNullOrEmpty(scanResult.DriverName) ? "N/A" : scanResult.DriverName)</span>
                            </div>
                            <div class="flex justify-between px-3 py-2">
                                <span class="text-slate-500 font-bold uppercase tracking-wider">Vendor</span>
                                <span class="font-bold text-slate-200">@(string.IsNullOrEmpty(scanResult.VendorName) ? "N/A" : scanResult.VendorName)</span>
                            </div>
                        </div>

                        <!-- Compliance indicators -->
                        @if (scanResult.ComplianceRecords?.Count > 0)
                        {
                            <div class="space-y-1.5">
                                <p class="text-[8.5px] font-bold text-slate-500 uppercase tracking-widest">Safety Checklist</p>
                                @foreach (var rec in scanResult.ComplianceRecords)
                                {
                                    <div class="flex items-center justify-between rounded bg-slate-850/60 border border-slate-800/80 px-3 py-1.5 text-[10px]">
                                        <div class="flex items-center gap-2">
                                            <span class="h-2 w-2 rounded-full @(rec.Status == "ACTIVE" ? "bg-emerald-500" : rec.Status == "WARNING" ? "bg-amber-500" : "bg-red-500")"></span>
                                            <span class="font-bold text-slate-300 uppercase">@rec.LicenseType.Replace("_", " ")</span>
                                        </div>
                                        <span class="text-[8.5px] text-slate-500 font-mono">EXP: @FormatDate(rec.ExpiryDate)</span>
                                    </div>
                                }
                            </div>
                        }

                        <button @onclick="ResetScanner" class="w-full rounded-lg bg-orange-500 hover:bg-orange-600 px-4 py-2 text-[10px] font-bold text-white uppercase tracking-wider transition-colors">
                            Scan Another Vehicle
                        </button>
                    </div>
                }

                <button type="button" @onclick="CloseScanner" class="w-full mt-5 rounded-lg border border-slate-800 bg-slate-850 hover:bg-slate-800 text-slate-400 py-2.5 text-xs font-bold transition-all">
                    Turn Off Camera
                </button>
            </div>
        </div>
    }

    <!-- Header Block -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-xl bg-slate-900 border border-slate-800 text-white p-6 shadow-md shadow-slate-900/10">
        <div>
            <h2 class="text-xl font-bold tracking-wide uppercase">Refinery Divisions & Departments</h2>
            <p class="text-xs text-slate-400 mt-1">
                Manage divisions ownership profiles and monitor compliance index scores.
            </p>
        </div>

        @if (currentUser?.Role == "SUPER_ADMIN")
        {
            <button @onclick="OpenCreateModal" class="flex items-center gap-1.5 rounded bg-blue-600 hover:bg-blue-700 px-4 py-2.5 text-xs font-bold text-white shadow transition-all duration-200">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                <span>Add Department</span>
            </button>
        }
    </div>

    <!-- Departments Grid -->
    @if (loading)
    {
        <div class="flex h-64 items-center justify-center">
            <div class="h-10 w-10 animate-spin rounded-full border-4 border-iocl-orange border-t-transparent"></div>
        </div>
    }
    else if (departments.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-white py-16 text-center text-slate-400">
            <svg class="h-12 w-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
            <p class="text-sm font-bold text-slate-500">No departments found.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 font-sans">
            @foreach (var dept in departments)
            {
                <div class="rounded-xl border border-slate-200 bg-white p-5 card-hover flex flex-col justify-between">
                    <div>
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded bg-slate-50 border border-slate-100 text-slate-600">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                </div>
                                <div class="min-w-0">
                                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider leading-tight truncate">@dept.Name</h3>
                                    <span class="mt-1.5 inline-block rounded bg-slate-100 px-1.5 py-0.5 text-[8.5px] font-bold text-slate-500 tracking-wider">
                                        @dept.Code
                                    </span>
                                </div>
                            </div>

                            <!-- Compliance Score Gauge -->
                            <div class="rounded border px-2 py-1 text-center shrink-0 @GetScoreStyle(dept.ComplianceScore)">
                                <p class="text-[7px] font-bold uppercase tracking-wider leading-none">Score</p>
                                <p class="mt-0.5 text-xs font-black leading-none">@dept.ComplianceScore%</p>
                            </div>
                        </div>

                        <p class="mt-4 text-[11px] text-slate-500 leading-relaxed font-medium line-clamp-2">
                            @(string.IsNullOrEmpty(dept.Description) ? "No division description provided." : dept.Description)
                        </p>
                    </div>

                    <!-- Actions -->
                    <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between gap-3">
                        <button @onclick="() => StartScanner(dept)" class="flex items-center gap-1.5 rounded-lg border border-orange-200 bg-orange-50 hover:bg-orange-100 px-3.5 py-1.5 text-[9.5px] font-bold text-orange-600 uppercase tracking-wider transition-all">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h.01M16 16h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span>Scan Gate QR</span>
                        </button>

                        <div class="flex items-center gap-2">
                            @if (currentUser?.Role == "SUPER_ADMIN")
                            {
                                <button @onclick="() => OpenEditModal(dept)" class="rounded border border-slate-200 hover:bg-slate-50 p-1.5 text-slate-500 hover:text-slate-700" title="Edit Department">
                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                </button>
                                <button @onclick="() => DeleteDepartment(dept.Id)" class="rounded border border-red-100 hover:bg-red-50 p-1.5 text-red-500 hover:text-red-700" title="Delete Department">
                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-4v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create / Edit Modal -->
@if (isModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4" @onclick="() => isModalOpen = false">
        <div class="relative w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-2xl" @onclick:stopPropagation>
            <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">
                @(editMode ? "Update Department" : "Create Department")
            </h3>
            
            <form @onSubmit="HandleSubmit" class="mt-4 space-y-4">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="rounded bg-red-50 border border-red-200 text-red-600 text-xs p-3 font-semibold">
                        @modalError
                    </div>
                }

                <div>
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Department Name *</label>
                    <input type="text" required placeholder="e.g. Safety & Emergency Services" @bind="form.Name" class="w-full rounded-md border border-slate-200 py-2 px-3 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                </div>

                <div>
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Department Code *</label>
                    <input type="text" required placeholder="e.g. PN-SF-SAFE" @bind="form.Code" class="w-full rounded-md border border-slate-200 py-2 px-3 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-500 uppercase" />
                </div>

                <div>
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Description</label>
                    <textarea placeholder="Describe division responsibilities..." @bind="form.Description" rows="3" class="w-full rounded-md border border-slate-200 py-2 px-3 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-500"></textarea>
                </div>

                <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                    <button type="button" @onclick="() => isModalOpen = false" class="rounded border border-slate-200 hover:bg-slate-50 px-4 py-2 text-xs font-bold text-slate-500">
                        Cancel
                    </button>
                    <button type="submit" class="rounded bg-blue-600 hover:bg-blue-700 px-4 py-2 text-xs font-bold text-white shadow shadow-blue-600/10">
                        @(editMode ? "Save Changes" : "Create Division")
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    private UserDto? currentUser;
    private List<DepartmentDto> departments = new();
    private bool loading = true;

    // CRUD Modal States
    private bool isModalOpen = false;
    private bool editMode = false;
    private DepartmentDto? activeDept;
    private string modalError = string.Empty;
    private CreateDepartmentDto form = new();

    // Scanner States
    private DepartmentDto? scannerDept;
    private string cameraError = string.Empty;
    private string scanError = string.Empty;
    private bool isScanning = false;
    private bool loadingResult = false;
    private VehicleDto? scanResult;
    private DotNetObjectReference<Departments>? dotNetHelper;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            currentUser = await Api.GetMeAsync();
            await FetchDepts();
        }
    }

    private async Task FetchDepts()
    {
        loading = true;
        StateHasChanged();
        try
        {
            departments = await Api.GetDepartmentsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching departments: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        modalError = string.Empty;
        try
        {
            form.Code = form.Code?.ToUpper().Replace(" ", "");
            if (editMode && activeDept != null)
            {
                var updateDto = new UpdateDepartmentDto
                {
                    Name = form.Name,
                    Code = form.Code,
                    Description = form.Description
                };
                await Api.UpdateDepartmentAsync(activeDept.Id, updateDto);
            }
            else
            {
                await Api.CreateDepartmentAsync(form);
            }
            isModalOpen = false;
            await FetchDepts();
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
    }

    private async Task DeleteDepartment(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this department? All associations must be empty.");
        if (!confirm) return;

        try
        {
            await Api.DeleteDepartmentAsync(id);
            await FetchDepts();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private void OpenCreateModal()
    {
        form = new();
        activeDept = null;
        editMode = false;
        modalError = string.Empty;
        isModalOpen = true;
    }

    private void OpenEditModal(DepartmentDto dept)
    {
        activeDept = dept;
        form = new()
        {
            Name = dept.Name,
            Code = dept.Code,
            Description = dept.Description
        };
        editMode = true;
        modalError = string.Empty;
        isModalOpen = true;
    }

    // QR WebRTC scanner interop methods
    private async Task StartScanner(DepartmentDto dept)
    {
        scannerDept = dept;
        cameraError = string.Empty;
        scanError = string.Empty;
        scanResult = null;
        loadingResult = false;
        isScanning = true;
        StateHasChanged();

        await Task.Delay(200);

        dotNetHelper = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("qrScanner.start", "dept-scan-video", "dept-scan-canvas", dotNetHelper);
    }

    private async Task CloseScanner()
    {
        scannerDept = null;
        isScanning = false;
        await JS.InvokeVoidAsync("qrScanner.stop");
        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }
    }

    private async Task ResetScanner()
    {
        scanResult = null;
        scanError = string.Empty;
        loadingResult = false;
        isScanning = true;
        StateHasChanged();

        await Task.Delay(200);
        await JS.InvokeVoidAsync("qrScanner.start", "dept-scan-video", "dept-scan-canvas", dotNetHelper);
    }

    [JSInvokable]
    public void OnCameraError(string errorMessage)
    {
        cameraError = errorMessage;
        isScanning = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnQrCodeScanned(int vehicleId)
    {
        isScanning = false;
        loadingResult = true;
        StateHasChanged();

        try
        {
            // Fetch verified status from public verify endpoint
            var baseUrl = Config["Backend:Url"] ?? "http://localhost:5000";
            var response = await JS.InvokeAsync<string>("fetch", $"{baseUrl}/api/vehicles/verify/{vehicleId}");
            var json = System.Text.Json.JsonDocument.Parse(response);
            var root = json.RootElement;
            if (root.GetProperty("success").GetBoolean())
            {
                var data = root.GetProperty("data");
                scanResult = new VehicleDto
                {
                    Id = data.GetProperty("id").GetInt32(),
                    VehicleNumber = data.GetProperty("vehicleNumber").GetString() ?? string.Empty,
                    VehicleType = data.GetProperty("vehicleType").GetString() ?? string.Empty,
                    DriverName = data.GetProperty("driverName").GetString() ?? string.Empty,
                    VendorName = data.GetProperty("vendorName").GetString() ?? string.Empty,
                    Status = data.GetProperty("overallStatus").GetString() ?? string.Empty,
                    OverallStatus = data.GetProperty("overallStatus").GetString() ?? string.Empty
                };

                if (data.TryGetProperty("complianceRecords", out var recList))
                {
                    scanResult.ComplianceRecords = new List<ComplianceRecordDto>();
                    foreach (var element in recList.EnumerateArray())
                    {
                        scanResult.ComplianceRecords.Add(new ComplianceRecordDto
                        {
                            Id = element.GetProperty("id").GetInt32(),
                            LicenseType = element.GetProperty("licenseType").GetString() ?? string.Empty,
                            ExpiryDate = element.GetProperty("expiryDate").GetString() ?? string.Empty,
                            Status = element.GetProperty("status").GetString() ?? string.Empty
                        });
                    }
                }
            }
            else
            {
                scanError = root.GetProperty("message").GetString() ?? "Vehicle not found.";
            }
        }
        catch (Exception ex)
        {
            scanError = $"Verification failed: {ex.Message}";
        }
        finally
        {
            loadingResult = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
        }
    }

    // CSS styling
    private string GetScoreStyle(double score)
    {
        if (score >= 90) return "text-emerald-600 bg-emerald-50 border-emerald-200";
        if (score >= 75) return "text-yellow-600 bg-yellow-50 border-yellow-200";
        return "text-red-600 bg-red-50 border-red-200";
    }

    private string FormatDate(string? d)
    {
        if (string.IsNullOrEmpty(d) || d == "PENDING") return "PENDING";
        if (DateTime.TryParse(d, out var dt))
        {
            return dt.ToString("dd-MMM-yyyy");
        }
        return d;
    }
}
